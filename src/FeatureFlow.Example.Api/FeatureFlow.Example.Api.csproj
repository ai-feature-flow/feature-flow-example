<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FeatureFlow.Example.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Lets WebApplicationFactory<Program> in the unit tests see the top-level Program class
         without making it public. -->
    <InternalsVisibleTo Include="FeatureFlow.Example.Api.UnitTests" />
  </ItemGroup>

</Project>
